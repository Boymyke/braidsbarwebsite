

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div class="section{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div class="bb-shell">
    <div
      class="spacing-style search-page__header bb-search"
      style="
        --horizontal-alignment: {{ section.settings.alignment }};
        {% render 'spacing-style', settings: section.settings %}
      "
    >
      <p class="bb-search__eyebrow">BRAIDBAR</p>
      <h1 class="bb-search__title">
        {%- if search.performed and search.terms != blank -%}
          {{ 'braidbar.search.results_for' | t: terms: search.terms }}
        {%- else -%}
          {{ 'braidbar.search.title' | t }}
        {%- endif -%}
      </h1>

      <form
        class="bb-search__form"
        action="{{ routes.search_url }}"
        method="get"
        role="search"
      >
        <label class="visually-hidden" for="bb-search-input-{{ section.id }}">{{ 'braidbar.search.label' | t }}</label>
        <svg class="bb-search__icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m16 16 5 5"></path>
        </svg>
        <input
          class="bb-search__input"
          id="bb-search-input-{{ section.id }}"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'braidbar.search.placeholder' | t }}"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="search"
          {% unless search.performed %}autofocus{% endunless %}
        >
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
        <input type="hidden" name="options[unavailable_products]" value="last">
        <button class="bb-search__submit" type="submit">{{ 'braidbar.search.submit' | t }}</button>
      </form>

      {% if search.performed %}
        <p class="bb-search__summary" role="status">
          {%- if search.results_count > 0 -%}
            {{ 'braidbar.search.count' | t: count: search.results_count }}
          {%- else -%}
            {{ 'braidbar.search.no_results' | t: terms: search.terms }}
          {%- endif -%}
        </p>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .bb-search {
    display: grid;
    gap: 14px;
    padding-block: clamp(28px, 5vw, 56px) clamp(12px, 2vw, 24px);
    color: var(--bb-ink, #181010);
  }

  .bb-search__eyebrow {
    margin: 0;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bb-mocha, #a89888);
  }

  .bb-search__title {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.1;
    font-weight: 400;
  }

  .bb-search__form {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    width: min(100%, 720px);
    margin-block-start: 8px;
    border: 1px solid var(--bb-dark, #201810);
    background: #fff;
  }

  .bb-search__icon {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 16px;
    transform: translateY(-50%);
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.5;
    stroke-linecap: round;
    pointer-events: none;
  }

  .bb-search__input {
    min-width: 0;
    min-height: 54px;
    padding: 12px 16px 12px 46px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1rem;
    -webkit-appearance: none;
    appearance: none;
  }

  .bb-search__input:focus {
    outline: none;
  }

  .bb-search__form:focus-within {
    outline: 2px solid var(--bb-dark, #201810);
    outline-offset: 2px;
  }

  .bb-search__submit {
    min-height: 54px;
    padding: 0 clamp(18px, 3vw, 32px);
    border: 0;
    border-radius: 0;
    background: var(--bb-dark, #201810);
    color: #fff;
    font: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .bb-search__submit:hover,
  .bb-search__submit:focus-visible {
    background: var(--bb-ink, #181010);
  }

  .bb-search__summary {
    margin: 0;
    font-size: 0.875rem;
    color: rgb(24 16 16 / 72%);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.search",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.direction_start"
        },
        {
          "value": "center",
          "label": "t:options.direction_center"
        },
        {
          "value": "flex-end",
          "label": "t:options.direction_end"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
