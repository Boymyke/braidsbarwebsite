{% liquid
  assign service_keys = 'braidbar.booking.service_knotless_box|braidbar.booking.service_small_knotless|braidbar.booking.service_medium_knotless|braidbar.booking.service_large_knotless|braidbar.booking.service_box|braidbar.booking.service_small_box|braidbar.booking.service_medium_box|braidbar.booking.service_large_box|braidbar.booking.service_jumbo_box|braidbar.booking.service_boho_knotless|braidbar.booking.service_boho_box|braidbar.booking.service_fulani|braidbar.booking.service_fulani_knotless|braidbar.booking.service_lemonade|braidbar.booking.service_goddess|braidbar.booking.service_goddess_knotless|braidbar.booking.service_french_curl|braidbar.booking.service_cornrows|braidbar.booking.service_simple_cornrows|braidbar.booking.service_stitch_cornrows|braidbar.booking.service_feed_in_cornrows|braidbar.booking.service_cornrows_extensions|braidbar.booking.service_braided_ponytail' | split: '|'
  assign service_prices = '65|85|75|60|65|85|70|55|50|90|85|75|85|65|80|90|85|35|30|45|50|55|60' | split: '|'
  capture available_day_numbers
    if section.settings.available_sunday
      echo '0,'
    endif
    if section.settings.available_monday
      echo '1,'
    endif
    if section.settings.available_tuesday
      echo '2,'
    endif
    if section.settings.available_wednesday
      echo '3,'
    endif
    if section.settings.available_thursday
      echo '4,'
    endif
    if section.settings.available_friday
      echo '5,'
    endif
    if section.settings.available_saturday
      echo '6,'
    endif
  endcapture
  assign available_day_numbers = available_day_numbers | strip_newlines | replace: ' ', ''
%}

<section class="bb-booking" aria-labelledby="bb-booking-page-title-{{ section.id }}">
  <div class="bb-shell">
    <div class="bb-booking__intro">
      <p class="bb-booking__eyebrow">{{ 'braidbar.booking.eyebrow' | t }}</p>
      <h1 id="bb-booking-page-title-{{ section.id }}">{{ 'braidbar.booking.title' | t }}</h1>
      <p class="bb-booking__lead">{{ 'braidbar.booking.intro' | t }}</p>
      <p class="bb-booking__included">{{ 'braidbar.booking.included' | t }}</p>
    </div>

    <div class="bb-booking__layout">
      <div class="bb-booking__services" aria-labelledby="bb-services-title-{{ section.id }}">
        <div class="bb-booking__services-heading">
          <p class="bb-booking__eyebrow">{{ 'braidbar.booking.price_eyebrow' | t }}</p>
          <h2 id="bb-services-title-{{ section.id }}">{{ 'braidbar.booking.price_title' | t }}</h2>
        </div>
        <ul class="bb-booking__price-list">
          {% for service_key in service_keys %}
            {% assign service_price = service_prices[forloop.index0] %}
            <li>
              <span>{{ service_key | t }}</span>
              <strong>€{{ service_price }}.00</strong>
            </li>
          {% endfor %}
        </ul>
        <dl class="bb-booking__details">
          <div>
            <dt>{{ 'braidbar.booking.languages_label' | t }}</dt>
            <dd>{{ 'braidbar.booking.languages_value' | t }}</dd>
          </div>
          <div>
            <dt>{{ 'braidbar.booking.area_label' | t }}</dt>
            <dd>{{ 'braidbar.booking.area_value' | t }}</dd>
          </div>
          <div>
            <dt>{{ 'braidbar.booking.confirmation_label' | t }}</dt>
            <dd>{{ 'braidbar.booking.confirmation_value' | t }}</dd>
          </div>
        </dl>
        <div class="bb-booking__contact">
          <p class="bb-booking__eyebrow">{% render 'bb-text', key: 'contact.heading' %}</p>
          {% render 'bb-contact', class: 'bb-contact--inline' %}
        </div>
      </div>

      <div class="bb-booking__form-card">
        {% form 'contact', class: 'bb-booking__form' %}
          {% if form.posted_successfully? %}
            <div class="bb-booking__success" role="status" aria-live="polite" tabindex="-1">
              {{ 'braidbar.booking.success' | t }}
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="bb-booking__errors" role="alert" aria-live="assertive" tabindex="-1">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <input type="hidden" name="contact[Request type]" value="Hair braiding appointment">
          <input class="bb-booking__price-input" type="hidden" name="contact[Service price]" value="">
          <input type="hidden" name="contact[Store availability]" value="{{ available_day_numbers | strip }} {{ section.settings.opening_time }}–{{ section.settings.closing_time }}">

          <div class="bb-booking__availability">
            <p class="bb-booking__availability-title">{{ 'braidbar.booking.availability_title' | t }}</p>
            <p>{{ 'braidbar.booking.availability_intro' | t }}</p>
            <ul aria-label="{{ 'braidbar.booking.availability_title' | t }}">
              {% if section.settings.available_monday %}<li>{{ 'braidbar.booking.day_monday' | t }}</li>{% endif %}
              {% if section.settings.available_tuesday %}<li>{{ 'braidbar.booking.day_tuesday' | t }}</li>{% endif %}
              {% if section.settings.available_wednesday %}<li>{{ 'braidbar.booking.day_wednesday' | t }}</li>{% endif %}
              {% if section.settings.available_thursday %}<li>{{ 'braidbar.booking.day_thursday' | t }}</li>{% endif %}
              {% if section.settings.available_friday %}<li>{{ 'braidbar.booking.day_friday' | t }}</li>{% endif %}
              {% if section.settings.available_saturday %}<li>{{ 'braidbar.booking.day_saturday' | t }}</li>{% endif %}
              {% if section.settings.available_sunday %}<li>{{ 'braidbar.booking.day_sunday' | t }}</li>{% endif %}
            </ul>
            {% if available_day_numbers == blank %}
              <p class="bb-booking__availability-hours">{{ 'braidbar.booking.no_availability' | t }}</p>
            {% endif %}
            {% if section.settings.opening_time != blank and section.settings.closing_time != blank %}
              <p class="bb-booking__availability-hours">
                {{ 'braidbar.booking.availability_hours' | t: opening: section.settings.opening_time, closing: section.settings.closing_time }}
              </p>
            {% endif %}
          </div>

          <div class="bb-booking__fields">
            <div class="bb-booking__field">
              <label for="bb-name-{{ section.id }}">{{ 'braidbar.booking.name' | t }}</label>
              <input id="bb-name-{{ section.id }}" name="contact[name]" autocomplete="name" required>
            </div>

            <div class="bb-booking__field">
              <label for="bb-email-{{ section.id }}">{{ 'braidbar.booking.email' | t }}</label>
              <input id="bb-email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required>
            </div>

            <div class="bb-booking__field">
              <label for="bb-phone-{{ section.id }}">{{ 'braidbar.booking.phone' | t }}</label>
              <input id="bb-phone-{{ section.id }}" type="tel" name="contact[Phone]" autocomplete="tel" required>
            </div>

            <div class="bb-booking__field">
              <label for="bb-language-{{ section.id }}">{{ 'braidbar.booking.preferred_language' | t }}</label>
              <select id="bb-language-{{ section.id }}" name="contact[Preferred language]">
                <option value="Português">Português</option>
                <option value="English">English</option>
              </select>
            </div>

            <div class="bb-booking__field bb-booking__field--full">
              <label for="bb-service-{{ section.id }}">{{ 'braidbar.booking.service' | t }}</label>
              <select class="bb-booking__service-select" id="bb-service-{{ section.id }}" name="contact[Service]" required>
                <option value="" data-price="">{{ 'braidbar.booking.choose_service' | t }}</option>
                {% for service_key in service_keys %}
                  {% assign service_price = service_prices[forloop.index0] %}
                  {% assign service_label = service_key | t %}
                  <option value="{{ service_label | escape }} — €{{ service_price }}.00" data-price="€{{ service_price }}.00">{{ service_label }} — €{{ service_price }}.00</option>
                {% endfor %}
              </select>
              <div class="bb-booking__selection" aria-live="polite">
                <span>{{ 'braidbar.booking.selected_price' | t }}</span>
                <output class="bb-booking__selected-price" for="bb-service-{{ section.id }}">—</output>
              </div>
            </div>

            <div class="bb-booking__field">
              <label for="bb-date-{{ section.id }}">{{ 'braidbar.booking.preferred_date' | t }}</label>
              <input
                class="bb-booking__date-input"
                id="bb-date-{{ section.id }}"
                type="date"
                name="contact[Preferred date]"
                min="{{ 'now' | date: '%Y-%m-%d' }}"
                data-available-days="{{ available_day_numbers | strip }}"
                data-unavailable-message="{{ 'braidbar.booking.unavailable_day' | t | escape }}"
                required
              >
              <p class="bb-booking__field-message" aria-live="polite"></p>
            </div>

            <div class="bb-booking__field">
              <label for="bb-time-{{ section.id }}">{{ 'braidbar.booking.preferred_time' | t }}</label>
              <input
                id="bb-time-{{ section.id }}"
                type="time"
                name="contact[Preferred time]"
                {% if section.settings.opening_time != blank %}min="{{ section.settings.opening_time | escape }}"{% endif %}
                {% if section.settings.closing_time != blank %}max="{{ section.settings.closing_time | escape }}"{% endif %}
                required
              >
            </div>

            <div class="bb-booking__field bb-booking__field--full">
              <label for="bb-message-{{ section.id }}">{{ 'braidbar.booking.notes' | t }}</label>
              <textarea id="bb-message-{{ section.id }}" name="contact[body]" rows="6" placeholder="{{ 'braidbar.booking.notes_placeholder' | t }}"></textarea>
            </div>
          </div>

          <button class="bb-booking__submit" type="submit">{{ 'braidbar.booking.submit' | t }}</button>
          <p class="bb-booking__note">{{ 'braidbar.booking.note' | t }}</p>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .bb-booking {
    color: var(--bb-ink, #181010);
    background: linear-gradient(145deg, #f7f2ed 0 55%, #eee5de 55% 100%);
    padding-block: var(--bb-section-space);
  }

  .bb-booking__intro {
    max-width: 940px;
    margin-block-end: clamp(36px, 6vw, 72px);
  }

  .bb-booking__eyebrow {
    margin: 0 0 14px;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .bb-booking h1,
  .bb-booking h2 {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    letter-spacing: -0.045em;
  }

  .bb-booking h1 {
    max-width: 12ch;
    font-size: clamp(3.25rem, 7vw, 7rem);
    line-height: 0.92;
  }

  .bb-booking h2 {
    font-size: clamp(2.25rem, 4vw, 4.25rem);
    line-height: 1;
  }

  .bb-booking__lead {
    max-width: 62ch;
    margin: 28px 0 0;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.75;
  }

  .bb-booking__included {
    display: inline-flex;
    margin: 22px 0 0;
    padding: 11px 14px;
    background: #181010;
    color: #fff;
    font-size: 0.75rem;
    line-height: 1.45;
    letter-spacing: 0.04em;
  }

  .bb-booking__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(360px, 0.88fr);
    align-items: start;
    gap: clamp(28px, 5vw, 72px);
  }

  .bb-booking__services,
  .bb-booking__form-card,
  .bb-booking__field {
    min-width: 0;
  }

  .bb-booking__services-heading {
    margin-block-end: 26px;
  }

  .bb-booking__price-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 28px;
    margin: 0;
    padding: 0;
    border-block-start: 1px solid rgb(24 16 16 / 22%);
    list-style: none;
  }

  .bb-booking__price-list li {
    min-width: 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding-block: 13px;
    border-block-end: 1px solid rgb(24 16 16 / 14%);
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .bb-booking__price-list strong {
    flex: 0 0 auto;
    font-weight: 600;
  }

  .bb-booking__details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin: 34px 0 0;
  }

  .bb-booking__details div {
    padding-block-start: 14px;
    border-block-start: 1px solid rgb(24 16 16 / 18%);
  }

  .bb-booking__details dt,
  .bb-booking__details dd {
    margin: 0;
  }

  .bb-booking__details dt {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .bb-booking__details dd {
    margin-block-start: 4px;
    font-size: 0.8125rem;
    line-height: 1.5;
    opacity: 0.72;
  }

  .bb-booking__contact {
    margin-block-start: 34px;
    padding: 22px;
    background: #fff;
    border: 1px solid rgb(24 16 16 / 12%);
  }

  .bb-booking__contact .bb-booking__eyebrow {
    margin-block-end: 14px;
  }

  .bb-booking__form-card {
    position: sticky;
    inset-block-start: 132px;
    padding: clamp(24px, 3.5vw, 48px);
    background: #fff;
    border: 1px solid rgb(24 16 16 / 12%);
    box-shadow: 0 24px 70px rgb(32 24 16 / 12%);
  }

  .bb-booking__success,
  .bb-booking__errors {
    margin-block-end: 22px;
    padding: 14px 16px;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .bb-booking__success {
    background: #eee5de;
  }

  .bb-booking__errors {
    color: #7d1c1c;
    background: #fff0f0;
  }

  .bb-booking__availability {
    margin-block-end: 22px;
    padding: 16px;
    background: #eee5de;
    border-inline-start: 3px solid var(--bb-mocha, #a89888);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .bb-booking__availability p {
    margin: 0;
  }

  .bb-booking__availability-title {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .bb-booking__availability ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .bb-booking__availability li {
    padding: 5px 8px;
    background: #fff;
  }

  .bb-booking__availability-hours {
    margin-block-start: 10px !important;
  }

  .bb-booking__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 18px;
  }

  .bb-booking__field {
    display: grid;
    gap: 8px;
  }

  .bb-booking__field--full {
    grid-column: 1 / -1;
  }

  .bb-booking__field label {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .bb-booking__field :is(input, select, textarea) {
    width: 100%;
    min-width: 0;
    min-height: 48px;
    padding: 12px 13px;
    color: var(--bb-ink, #181010);
    background: #fff;
    border: 1px solid rgb(24 16 16 / 32%);
    border-radius: 0;
  }

  .bb-booking__field textarea {
    min-height: 132px;
    resize: vertical;
  }

  .bb-booking__field-message {
    min-height: 1.25em;
    margin: 0;
    color: #7d1c1c;
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .bb-booking__field :is(input, select, textarea):focus-visible {
    border-color: var(--bb-dark, #201810);
    outline: 2px solid var(--bb-mocha, #a89888);
    outline-offset: 2px;
  }

  .bb-booking__selection {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 36px;
    padding: 8px 10px;
    color: #fff;
    background: #a89888;
    font-size: 0.75rem;
  }

  .bb-booking__selected-price {
    font-size: 1rem;
    font-weight: 700;
  }

  .bb-booking__submit {
    width: 100%;
    min-height: 52px;
    margin-block-start: 22px;
    padding: 12px 20px;
    color: #fff;
    background: var(--bb-dark, #201810);
    border: 1px solid var(--bb-dark, #201810);
    border-radius: 0;
    cursor: pointer;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bb-booking__submit:hover,
  .bb-booking__submit:focus-visible {
    background: var(--bb-mocha, #a89888);
    border-color: var(--bb-mocha, #a89888);
  }

  .bb-booking__note {
    margin: 14px 0 0;
    font-size: 0.75rem;
    line-height: 1.55;
    opacity: 0.68;
  }

  @media (max-width: 1050px) {
    .bb-booking__layout {
      grid-template-columns: 1fr;
    }

    .bb-booking__form-card {
      position: static;
    }
  }

  @media (max-width: 699px) {
    .bb-booking__price-list,
    .bb-booking__details,
    .bb-booking__fields {
      grid-template-columns: 1fr;
    }

    .bb-booking__field--full {
      grid-column: auto;
    }

    .bb-booking__form-card {
      padding: 22px 16px 26px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.bb-booking__service-select').forEach((select) => {
    const form = select.closest('.bb-booking__form');
    const priceOutput = form.querySelector('.bb-booking__selected-price');
    const priceInput = form.querySelector('.bb-booking__price-input');

    const updatePrice = () => {
      const selectedOption = select.options[select.selectedIndex];
      const selectedPrice = selectedOption.dataset.price || '—';
      priceOutput.textContent = selectedPrice;
      priceInput.value = selectedOption.dataset.price || '';
    };

    select.addEventListener('change', updatePrice);
    updatePrice();
  });

  document.querySelectorAll('.bb-booking__date-input').forEach((dateInput) => {
    const availableDays = (dateInput.dataset.availableDays || '')
      .split(',')
      .filter(Boolean)
      .map(Number);
    const message = dateInput.closest('.bb-booking__field')?.querySelector('.bb-booking__field-message');

    const validateDate = () => {
      if (!dateInput.value) {
        dateInput.setCustomValidity('');
        if (message) message.textContent = '';
        return;
      }

      const selectedDay = new Date(`${dateInput.value}T12:00:00`).getDay();
      const isAvailable = availableDays.length > 0 && availableDays.includes(selectedDay);
      const errorMessage = isAvailable ? '' : dateInput.dataset.unavailableMessage || '';
      dateInput.setCustomValidity(errorMessage);
      if (message) message.textContent = errorMessage;
    };

    dateInput.addEventListener('change', validateDate);
    dateInput.addEventListener('input', validateDate);
    validateDate();
  });

  document.querySelector('.bb-booking__success, .bb-booking__errors')?.focus();
{% endjavascript %}

{% schema %}
{
  "name": "BRAIDBAR booking",
  "settings": [
    {
      "type": "header",
      "content": "Appointment availability"
    },
    {
      "type": "paragraph",
      "content": "Choose the days and request hours shown to customers. Requests still require manual confirmation."
    },
    {
      "type": "checkbox",
      "id": "available_monday",
      "label": "Monday",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "available_tuesday",
      "label": "Tuesday",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "available_wednesday",
      "label": "Wednesday",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "available_thursday",
      "label": "Thursday",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "available_friday",
      "label": "Friday",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "available_saturday",
      "label": "Saturday",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "available_sunday",
      "label": "Sunday",
      "default": true
    },
    {
      "type": "text",
      "id": "opening_time",
      "label": "Earliest request time",
      "info": "Use 24-hour format, for example 09:00.",
      "default": "09:00"
    },
    {
      "type": "text",
      "id": "closing_time",
      "label": "Latest request time",
      "info": "Use 24-hour format, for example 18:00.",
      "default": "18:00"
    }
  ],
  "presets": [
    {
      "name": "BRAIDBAR booking"
    }
  ]
}
{% endschema %}
