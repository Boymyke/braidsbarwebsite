{% comment %}
  Shared BRAIDBAR storefront footer.
  @example
  <!-- Rendered from sections/footer-group.json on every storefront template -->
{% endcomment %}

<footer class="bb-site-footer">
  <div class="bb-shell bb-site-footer__grid">
    <div class="bb-site-footer__brand">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        <img
          src="{{ 'braidbar-logo.svg' | asset_url }}"
          width="952"
          height="138"
          alt="{{ shop.name | escape }}"
          loading="lazy"
        >
      </a>
      <p>{{ 'braidbar.footer.intro' | t }}</p>
    </div>

    <nav aria-label="{{ 'braidbar.footer.shop_heading' | t }}">
      <h2>{{ 'braidbar.footer.shop_heading' | t }}</h2>
      <a href="{{ routes.collections_url }}/wigs">{{ 'braidbar.nav.wigs' | t }}</a>
      <a href="{{ routes.collections_url }}/bundles">{{ 'braidbar.nav.bundles' | t }}</a>
      <a href="{{ routes.collections_url }}/lace-fronts">{{ 'braidbar.nav.lace_fronts' | t }}</a>
      <a href="{{ routes.collections_url }}/closures">{{ 'braidbar.nav.closures' | t }}</a>
    </nav>

    <nav aria-label="{{ 'braidbar.footer.help_heading' | t }}">
      <h2>{{ 'braidbar.footer.help_heading' | t }}</h2>
      <a href="/pages/book-appointment">{{ 'braidbar.nav.appointments' | t }}</a>
      <a href="/pages/about">{{ 'braidbar.nav.about' | t }}</a>
      <a href="/pages/faqs">{{ 'braidbar.nav.faqs' | t }}</a>
      <a href="#bb-footer-contact">{{ 'braidbar.nav.contact' | t }}</a>
      <a href="{{ routes.search_url }}">{{ 'braidbar.header.search' | t }}</a>
    </nav>

    <div class="bb-site-footer__service">
      <h2>{{ 'braidbar.footer.service_heading' | t }}</h2>
      <p>{{ 'braidbar.footer.service_area' | t }}</p>
      <p>{{ 'braidbar.footer.languages' | t }}</p>
      <p>{{ 'braidbar.footer.checkout' | t }}</p>
    </div>

    <div class="bb-site-footer__contact" id="bb-footer-contact">
      <h2>{% render 'bb-text', key: 'contact.heading' %}</h2>
      {% render 'bb-contact', class: 'bb-contact--dark' %}
    </div>
  </div>

  <div class="bb-shell bb-site-footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} BRAIDBAR</span>
    <span>{% render 'bb-text', key: 'footer.location' %}</span>
  </div>
</footer>

{%- if template.name == 'index' or template.suffix == 'about' or template.suffix == 'book-appointment' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "HairSalon",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | append: routes.root_url | json }},
      "logo": {{ 'braidbar-logo.svg' | asset_url | prepend: 'https:' | json }},
      "telephone": "+351920224758",
      "email": "Braidbarstore@gmail.com",
      "priceRange": "€€",
      "currenciesAccepted": "EUR",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Avenida Infante Dom Henrique 89",
        "addressLocality": "Lisboa",
        "addressCountry": "PT"
      },
      "areaServed": "PT"
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .bb-site-footer {
    color: #fff;
    background: var(--bb-dark, #201810);
  }

  .bb-site-footer__grid {
    display: grid;
    grid-template-columns: minmax(220px, 1.4fr) repeat(4, minmax(130px, 1fr));
    gap: clamp(32px, 5vw, 72px);
    padding-block: clamp(48px, 7vw, 88px);
  }

  .bb-site-footer__brand,
  .bb-site-footer__grid > * {
    min-width: 0;
  }

  .bb-site-footer__brand a {
    display: block;
    width: min(100%, 280px);
  }

  .bb-site-footer__brand img {
    width: 100%;
    height: auto;
    filter: invert(1);
  }

  .bb-site-footer h2 {
    margin: 0 0 18px;
    color: inherit;
    font-size: 0.75rem;
    line-height: 1.3;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bb-site-footer p,
  .bb-site-footer a {
    color: rgb(255 255 255 / 74%);
    font-size: 0.8125rem;
    line-height: 1.65;
  }

  .bb-site-footer p {
    margin: 0 0 10px;
  }

  .bb-site-footer nav a {
    display: block;
    width: fit-content;
    padding-block: 3px;
    text-decoration: none;
  }

  .bb-site-footer nav a:hover,
  .bb-site-footer nav a:focus-visible {
    color: #fff;
    text-decoration-color: currentcolor;
  }

  .bb-site-footer__brand p {
    max-width: 34ch;
    margin-block-start: 22px;
  }

  .bb-site-footer__bottom {
    min-height: 62px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-block-start: 1px solid rgb(255 255 255 / 16%);
    color: rgb(255 255 255 / 60%);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bb-site-footer__contact .bb-contact {
    gap: 14px;
  }

  .bb-site-footer__contact .bb-contact__value {
    font-size: 0.8125rem;
  }

  @media (max-width: 1199px) {
    .bb-site-footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .bb-site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 989px) {
    .bb-site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 599px) {
    .bb-site-footer__grid {
      grid-template-columns: 1fr;
      gap: 34px;
      padding-block: 48px;
    }

    .bb-site-footer__bottom {
      min-height: 76px;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 5px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [],
  "presets": []
}
{% endschema %}
