{%- doc -%}
  Small bilingual (English / Portuguese) copy for the BRAIDBAR search page
  and contact details. Kept here so the theme's locale files stay untouched.

  @param {string} key - Copy key, e.g. 'search.title'
  @param {string} [terms] - Search terms, inserted where the copy needs them
  @param {number} [count] - Result count, inserted where the copy needs it

  @example
  {% render 'bb-text', key: 'search.title' %}
{%- enddoc -%}
{%- liquid
  assign bb_pt = false
  if request.locale.iso_code contains 'pt'
    assign bb_pt = true
  endif
  assign bb_terms = terms | escape
  assign bb_text = ''

  case key
    when 'search.title'
      if bb_pt
        assign bb_text = 'Pesquise a coleção BRAIDBAR'
      else
        assign bb_text = 'Search the BRAIDBAR collection'
      endif
    when 'search.results_for'
      if bb_pt
        assign bb_text = 'Resultados para “' | append: bb_terms | append: '”'
      else
        assign bb_text = 'Results for “' | append: bb_terms | append: '”'
      endif
    when 'search.label'
      if bb_pt
        assign bb_text = 'Pesquisar produtos'
      else
        assign bb_text = 'Search products'
      endif
    when 'search.placeholder'
      if bb_pt
        assign bb_text = 'Pesquise perucas, bundles, lace fronts…'
      else
        assign bb_text = 'Search wigs, bundles, lace fronts…'
      endif
    when 'search.submit'
      if bb_pt
        assign bb_text = 'Pesquisar'
      else
        assign bb_text = 'Search'
      endif
    when 'search.count'
      if bb_pt
        if count == 1
          assign bb_text = '1 produto encontrado'
        else
          assign bb_text = count | append: ' produtos encontrados'
        endif
      else
        if count == 1
          assign bb_text = '1 product found'
        else
          assign bb_text = count | append: ' products found'
        endif
      endif
    when 'search.no_results'
      if bb_pt
        assign bb_text = 'Nenhum produto corresponde a “' | append: bb_terms | append: '”. Experimente uma palavra mais curta, uma textura (liso, ondulado, cacheado) ou um comprimento.'
      else
        assign bb_text = 'No products matched “' | append: bb_terms | append: '”. Try a shorter word, a texture (straight, body wave, curly) or a length.'
      endif
    when 'search.suggestions'
      if bb_pt
        assign bb_text = 'Também pode gostar'
      else
        assign bb_text = 'You may also like'
      endif
    when 'search.browse'
      if bb_pt
        assign bb_text = 'Ver todo o cabelo'
      else
        assign bb_text = 'Shop all hair'
      endif
    when 'contact.heading'
      if bb_pt
        assign bb_text = 'Contacto'
      else
        assign bb_text = 'Contact'
      endif
    when 'contact.phone_label'
      if bb_pt
        assign bb_text = 'Telefone / WhatsApp'
      else
        assign bb_text = 'Phone / WhatsApp'
      endif
    when 'contact.email_label'
      assign bb_text = 'Email'
    when 'contact.address_label'
      if bb_pt
        assign bb_text = 'Estúdio'
      else
        assign bb_text = 'Studio'
      endif
    when 'contact.whatsapp'
      if bb_pt
        assign bb_text = 'Falar no WhatsApp'
      else
        assign bb_text = 'Chat on WhatsApp'
      endif
    when 'contact.directions'
      if bb_pt
        assign bb_text = 'Ver direções'
      else
        assign bb_text = 'Get directions'
      endif
    when 'footer.location'
      if bb_pt
        assign bb_text = 'Lisboa, Portugal'
      else
        assign bb_text = 'Lisbon, Portugal'
      endif
    when 'booking.confirm_eyebrow'
      if bb_pt
        assign bb_text = 'Pedido recebido'
      else
        assign bb_text = 'Request received'
      endif
    when 'booking.confirm_title'
      if bb_pt
        assign bb_text = 'Obrigada! O seu pedido de marcação foi recebido.'
      else
        assign bb_text = 'Thank you! Your appointment request has been received.'
      endif
    when 'booking.confirm_text'
      if bb_pt
        assign bb_text = 'A BRAIDBAR vai contactá-la em breve por telefone, WhatsApp ou email para confirmar a data e a hora.'
      else
        assign bb_text = 'BRAIDBAR will contact you shortly by phone, WhatsApp or email to confirm your date and time.'
      endif
    when 'booking.confirm_step_1'
      if bb_pt
        assign bb_text = 'Verificamos a disponibilidade para a data e hora escolhidas.'
      else
        assign bb_text = 'We check availability for your chosen date and time.'
      endif
    when 'booking.confirm_step_2'
      if bb_pt
        assign bb_text = 'Confirmamos a sua marcação por WhatsApp, telefone ou email.'
      else
        assign bb_text = 'We confirm your appointment by WhatsApp, phone or email.'
      endif
    when 'booking.confirm_step_3'
      if bb_pt
        assign bb_text = 'Paga no salão, no dia da marcação. Nada é cobrado online.'
      else
        assign bb_text = 'You pay at the salon on the day. Nothing is charged online.'
      endif
    when 'booking.confirm_whatsapp'
      if bb_pt
        assign bb_text = 'Falar no WhatsApp'
      else
        assign bb_text = 'Message us on WhatsApp'
      endif
    when 'booking.confirm_again'
      if bb_pt
        assign bb_text = 'Fazer outro pedido'
      else
        assign bb_text = 'Book another appointment'
      endif
    when 'booking.confirm_home'
      if bb_pt
        assign bb_text = 'Voltar ao início'
      else
        assign bb_text = 'Back to home'
      endif
    when 'booking.note'
      if bb_pt
        assign bb_text = 'Sem pagamento online: paga no salão, no dia da marcação. Confirmamos cada marcação pessoalmente.'
      else
        assign bb_text = 'No online payment: you pay at the salon on the day. We confirm every appointment personally.'
      endif
    when 'booking.payment_label'
      if bb_pt
        assign bb_text = 'Pagamento'
      else
        assign bb_text = 'Payment'
      endif
    when 'booking.payment_value'
      if bb_pt
        assign bb_text = 'No salão, no dia da marcação'
      else
        assign bb_text = 'At the salon, on the day'
      endif
    when 'booking.sending'
      if bb_pt
        assign bb_text = 'A enviar o seu pedido…'
      else
        assign bb_text = 'Sending your request…'
      endif
  endcase

  echo bb_text
-%}
